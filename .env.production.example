# Web. Set a real domain after its A/AAAA record points to this server.
# Use :80 temporarily when deploying without a domain or HTTPS.
SITE_ADDRESS=example.com
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=local

# Application
APP_NAME=栗子杯 API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL. Keep POSTGRES_PASSWORD and the password in DATABASE_URL identical.
# Generate URL-safe secrets with: openssl rand -hex 24
POSTGRES_DB=lizibei
POSTGRES_USER=lizibei_app
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql://lizibei_app:replace-with-a-random-hex-password@postgres:5432/lizibei

# Authentication. Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-different-random-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Same-origin requests do not require CORS. Keep the public origin here for clarity.
CORS_ORIGINS=["https://example.com"]

# QQ OAuth is optional. The callback must match the public domain exactly.
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
QQ_OAUTH_REDIRECT_URI=https://example.com/login/qq/callback

# Upload limit in bytes. Uploaded files are stored in a Docker named volume.
UPLOAD_MAX_BYTES=5242880
