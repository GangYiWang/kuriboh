# Application
APP_NAME=栗子杯 API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
LOG_LEVEL=INFO

# PostgreSQL — replace the password outside local development.
POSTGRES_DB=lizibei_dev
POSTGRES_USER=lizibei_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lizibei_app:change-me@127.0.0.1:5432/lizibei_dev

# JSON array consumed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend uses /api through the Vite proxy by default.
VITE_API_BASE_URL=/api

# Authentication — generate a long random value for every environment.
AUTH_SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# QQ OAuth is optional until official application credentials are available.
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
QQ_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/login/qq/callback

# Local image storage for content and deck screenshots. Production should use a persistent volume or object storage.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
